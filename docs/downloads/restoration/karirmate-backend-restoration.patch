+        remaining = max(0, limit-quota_used(db, uid, now))
+        consent = bool(row and row[0] and row[2] and cfg and cfg[0])
+    plan = items[:remaining] if consent else []
+    return dict(success=True, mode='simulation', sending_enabled=False, sent=0, writes_performed=False,
+                plan=plan, remaining_today=remaining, diagnosis=reason, consent_granted=consent,
+                note='Simulasi tidak mengirim email atau mencatat status terkirim. Gmail, PRO, jadwal, kemampuan worker untuk lamaran spontan, dan izin operator diperiksa kembali saat pengiriman nyata.')
