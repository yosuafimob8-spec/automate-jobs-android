diff --git a/termux/automate-ai/auto_apply_diagnostics.py b/termux/automate-ai/auto_apply_diagnostics.py
new file mode 100644
index 0000000..69f135c
--- /dev/null
+++ b/termux/automate-ai/auto_apply_diagnostics.py
@@ -0,0 +1,134 @@
+"""Read-only, account-scoped selection and reporting. Never contacts the Gmail worker."""
+import json
+import re
+import sqlite3
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+from zoneinfo import ZoneInfo
+from runtime_paths import DB
+
+WIB = ZoneInfo('Asia/Jakarta')
+
+def diagnosis(code, message, action, **details):
+    return dict(code=code, message=message, action=action, details=details)
+
+def connect():
+    return sqlite3.connect(f'file:{DB}?mode=ro', uri=True, timeout=30)
+
+def _list(value):
+    try:
+        items = json.loads(value or '[]')
+        return [s.strip() for s in items if isinstance(s, str) and s.strip()] if isinstance(items, list) else []
+    except (ValueError, TypeError):
+        return []
+
+def selection(account_id, uid):
+    from candidate_selection import select_for_profile
+    from phase512_sender import extract_cv_text
+    with connect() as db:
+        db.row_factory = sqlite3.Row
+        account = db.execute('SELECT telegram_user_id FROM android_accounts WHERE id=?', (account_id,)).fetchone()
+        if not account or account[0] != uid:
+            return [], diagnosis('CANDIDATE_NOT_FOUND', 'Identitas kandidat belum terhubung ke akun ini.', 'Tautkan akun Telegram pada profil; jangan membuat akun kandidat baru.')
+        profile = db.execute('SELECT desired_positions,preferred_locations FROM android_profiles WHERE account_id=?', (account_id,)).fetchone()
+        positions, locations = (_list(profile[0]), _list(profile[1])) if profile else ([], [])
+        if not positions or not locations:
+            return [], diagnosis('PROFILE_INCOMPLETE', 'Posisi tujuan atau lokasi kerja belum lengkap.', 'Lengkapi posisi dan lokasi di Profil Pengguna.')
+        cfg = db.execute('SELECT cv_path FROM phase5_config WHERE user_id=?', (uid,)).fetchone()
+        cv_path = Path(cfg[0] or '') if cfg else Path('')
+        if not cv_path.is_file():
+            return [], diagnosis('CV_NOT_AVAILABLE', 'CV kandidat belum tersedia di backend.', 'Unggah CV PDF melalui Kirim Lamaran.')
+        try:
+            cv_text = extract_cv_text(cv_path)
+        except ImportError:
+            return [], diagnosis('BACKEND_ERROR', 'Mesin ekstraksi PDF backend belum tersedia.', 'Operator perlu memasang dependensi pypdf.')
+        except Exception:
+            return [], diagnosis('CV_NOT_AVAILABLE', 'Teks CV belum dapat dibaca; pencocokan belum dijalankan.', 'Unggah PDF berbasis teks tanpa kata sandi. PDF scan memerlukan OCR.')
+        tables = {r[0] for r in db.execute("SELECT name FROM sqlite_master WHERE type='table'")}
+        claimed = {r[0].strip().lower() for r in db.execute('SELECT email FROM phase57_delivery_claims WHERE user_id=?', (uid,))} if 'phase57_delivery_claims' in tables else set()
+        rows, unsupported = [], []
+        for table in ('km_stage1_sources', 'km_companies'):
+            columns = {r[1] for r in db.execute(f'PRAGMA table_info({table})')}
+            if not {'company', 'email', 'position', 'user_id', 'location'} <= columns:
+                unsupported.append(table)
+                continue
+            for row in db.execute(f'SELECT * FROM {table} WHERE user_id=?', (uid,)):
+                c = dict(row)
+                source = c.get('source_url') or c.get('source') or c.get('contact_source') or ''
+                verified = c.get('vacancy_verified') in (True, 1) and c.get('active') in (True, 1)
+                rows.append(dict(c, source_url=source, contact_source=source,
+                                 kind='vacancy' if verified else 'spontaneous', vacancy_verified=verified, active=verified))
+        # Pending rows may outlive the source import, but must pass the same current profile rules.
+        if 'phase57_queue' in tables:
+            for row in db.execute("SELECT * FROM phase57_queue WHERE user_id=? AND status IN ('ready','queued')", (uid,)):
+                c = dict(row)
+                rows.append(dict(c, position=c['job_title'], source_url=c['job_url'],
+                                 vacancy_verified=c.get('kind') == 'vacancy', active=c.get('kind') == 'vacancy'))
+    matching = [r for r in rows if any(word in cv_text for word in re.findall(r'[a-z]{3,}', str(r.get('position') or '').casefold()))]
+    # Filter claims BEFORE selecting the first five, so the sixth contact can fill a free slot.
+    eligible = select_for_profile(matching, positions, locations)
+    available = select_for_profile([r for r in matching if str(r.get('email') or '').strip().lower() not in claimed], positions, locations)
+    if available:
+        vacancies = sum(r['kind'] == 'vacancy' for r in available)
+        return available, diagnosis('READY' if vacancies else 'READY_SPONTANEOUS',
+            'Penerima sesuai profil tersedia.' if vacancies else 'Tidak ada lowongan aktif terverifikasi; tersedia kontak untuk lamaran spontan.',
+            'Periksa rencana simulasi dan status izin pengiriman.', active_vacancies=vacancies,
+            spontaneous=len(available)-vacancies, missing_or_unsupported_tables=unsupported)
+    if eligible:
+        return [], diagnosis('ALL_RECIPIENTS_ALREADY_CONTACTED', 'Semua penerima yang sesuai sudah dihubungi atau memiliki pengiriman yang belum pasti.', 'Tambahkan kontak rekrutmen baru dengan sumber yang dapat diperiksa. Pengiriman tidak diulang otomatis.')
+    code = 'NO_MATCHING_VACANCY' if rows else 'NO_ELIGIBLE_RECIPIENT'
+    return [], diagnosis(code, 'Tidak ada lowongan atau kontak rekrutmen yang memenuhi posisi, lokasi, CV, dan bukti sumber.',
+        'Periksa posisi/lokasi profil dan data kontak perusahaan. Kontak tanpa sumber atau lokasi tidak dipilih.', missing_or_unsupported_tables=unsupported)
+
+def _datetime(value):
+    try:
+        dt = datetime.fromisoformat(value)
+        return dt.replace(tzinfo=timezone.utc) if dt.tzinfo is None else dt
+    except (ValueError, TypeError):
+        return None
+
+def delivery_report(uid, period='today', offset=0, now=None):
+    if period not in ('today', '7d', '30d', 'all'):
+        raise ValueError('Filter harus today, 7d, 30d, atau all.')
+    now = (now or datetime.now(timezone.utc)).astimezone(WIB)
+    days = {'today': 1, '7d': 7, '30d': 30}
+    start = datetime.combine(now.date()-timedelta(days=days.get(period, 1)-1), datetime.min.time(), WIB)
+    with connect() as db:
+        db.row_factory = sqlite3.Row
+        rows = db.execute('''SELECT id,company,job_title,email,status,created_at,claimed_at,sent_at,
+            gmail_message_id,error,kind,attempt_day FROM phase57_queue WHERE user_id=? ORDER BY id DESC''', (uid,)).fetchall()
+    items, selected, today = [], [], []
+    for row in rows:
+        item = dict(row)
+        original = item['status']
+        item['raw_status'] = original
+        item['status'] = {'ready': 'waiting', 'queued': 'waiting', 'sending': 'processing', 'cancelled': 'cancelled', 'blocked': 'configuration_blocked'}.get(original, original)
+        if original == 'sent' and str(item['gmail_message_id'] or '').strip().lower() in ('', 'null', 'none'):
+            item['status'] = 'uncertain'
+        item['timestamp'] = item['sent_at'] or item['claimed_at'] or item['created_at']
+        dt = _datetime(item['timestamp'])
+        # Pending rows have not failed or been sent even when production is blocked.
+        items.append(item)
+        if dt and dt.astimezone(WIB).date() == now.date(): today.append(item)
+        if period == 'all' or (dt and start <= dt.astimezone(WIB) <= now): selected.append(item)
+    def count(data, status): return sum(x['status'] in status for x in data)
+    summary = dict(target=5, sent_today=count(today, ('sent',)), failed_today=count(today, ('failed',)),
+                   pending=count(items, ('waiting', 'processing')), pending_today=count(today, ('waiting', 'processing')), uncertain=count(items, ('uncertain',)),
+                   total_sent=count(items, ('sent',)), filtered_count=len(selected))
+    return dict(items=selected[offset:offset+100], summary=summary, period=period, offset=offset,
+                next_offset=offset+100 if len(selected)>offset+100 else None, timezone='Asia/Jakarta')
+
+def simulate(account_id, uid, now=None):
+    """No writes, worker calls, settings changes, claims, or delivery history rows."""
+    from phase512_sender import quota_used
+    items, reason = selection(account_id, uid)
+    with connect() as db:
+        row = db.execute('SELECT enabled,daily_limit,consent_at FROM phase57_settings WHERE user_id=?', (uid,)).fetchone()
