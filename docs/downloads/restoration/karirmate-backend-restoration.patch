+"""Test API access boundaries with explicit service/identity fixtures, no real bank."""
+import importlib.util
+from pathlib import Path
+import sys
+import types
+import unittest
+from unittest.mock import patch
+
+ROOT=Path(__file__).resolve().parents[1]/'termux'/'automate-jobs-v2'
+sys.path.insert(0,str(ROOT))
+
+class PsychotestApiAccessTest(unittest.TestCase):
+    def setUp(self):
+        service=types.ModuleType('psychotest_service')
+        service.API_VERSION=1;service.PsychotestError=Exception;service.PsychotestService=object
+        service.TESTS={'logic':{'family':'private','categories':{'logic':10},'title':'Logika'}}
+        identity=types.ModuleType('search_identity');identity.IdentityError=Exception;identity.android_subject=lambda _:None
+        self.patcher=patch.dict(sys.modules,psychotest_service=service,search_identity=identity)
+        self.patcher.start();self.addCleanup(self.patcher.stop)
+        spec=importlib.util.spec_from_file_location('api_access_fixture',ROOT/'psychotest_api.py')
+        self.module=importlib.util.module_from_spec(spec);spec.loader.exec_module(self.module)
+        class Service:
+            def start_session(self,*args,**kwargs):return {'ok':True,'count':kwargs['question_count']}
+            def submit(self,*args):return {'ok':True,'result':{'score':10,'analysis':{'real':'fixture'},'questions':[{'explanation':'fixture'}]}}
+            result=submit
+        self.free=self.module.PsychotestApi(Service(),identity_resolver=lambda _:('android:1',{'account_id':1,'is_pro':False}))
+        self.pro=self.module.PsychotestApi(Service(),identity_resolver=lambda _:('android:2',{'account_id':2,'is_pro':True}))
+
+    def test_free_training_works_full_requires_pro_and_body_cannot_grant_access(self):
+        self.assertEqual(10,self.free.start('fixture',{'test_id':'logic','question_count':10})['count'])
+        with self.assertRaises(self.module.ApiError) as error:self.free.start('fixture',{'test_id':'logic','is_pro':True})
+        self.assertEqual(403,error.exception.status)
+        self.assertIsNone(self.pro.start('fixture',{'test_id':'logic'})['count'])
+
+    def test_submit_and_result_both_redact_only_pro_fields(self):
+        for action in ('submit','result'):
+            free=self.free.session('fixture','id',action)['result'];pro=self.pro.session('fixture','id',action)['result']
+            self.assertEqual(10,free['score']);self.assertNotIn('analysis',free);self.assertIn('analysis',pro)
