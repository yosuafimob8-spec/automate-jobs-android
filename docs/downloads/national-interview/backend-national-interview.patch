+"""Company/position duplicate guard used inside the sender's SQLite transaction."""
+from datetime import datetime,timedelta,timezone
+import json
+from pathlib import Path
+from national_directory import company_key,position_key
+
+POLICY=Path(__file__).resolve().parent/'data'/'auto_apply_policy.json'
+def duplicate_days():return max(1,int(json.loads(POLICY.read_text()).get('company_position_duplicate_days',90)))
+def recently_contacted(db,uid,company,position,now=None):
+    now=now or datetime.now(timezone.utc);since=now-timedelta(days=duplicate_days())
+    for name,title,status,sent_at,claimed_at in db.execute("SELECT company,job_title,status,sent_at,claimed_at FROM phase57_queue WHERE user_id=? AND status IN ('sent','sending','uncertain')",(uid,)):
+        if company_key(name)!=company_key(company) or position_key(title)!=position_key(position):continue
+        if status in ('sending','uncertain'):return True
+        value=sent_at or claimed_at
+        try:
+            when=datetime.fromisoformat(value)
+            if when.tzinfo is None:when=when.replace(tzinfo=timezone.utc)
+            if when>=since:return True
+        except (TypeError,ValueError):return True
+    return False
