@@ -0,0 +1,18 @@
+"""Prepare one reviewable Gmail test message. This module has NO sending function."""
+import hashlib
+import re
+from phase512_sender import valid_target
+
+def preview(recipient,applicant_name,cv_text,cv_sha256):
+    if not valid_target(recipient):raise ValueError('Pilih satu alamat penerima uji yang valid.')
+    if not applicant_name.strip() or len(applicant_name)>120:raise ValueError('Nama kandidat dari profil wajib tersedia.')
+    if sum(c.isalpha() for c in cv_text)<40:raise ValueError('CV harus benar-benar berhasil dibaca.')
+    if not re.fullmatch(r'[a-f0-9]{64}',cv_sha256):raise ValueError('Fingerprint CV diperlukan.')
+    subject='Uji Integrasi Gmail KarirMate — '+applicant_name.strip()
+    content=('Yth. Penerima Uji,\n\nEmail ini dipersiapkan untuk satu pengujian integrasi Gmail KarirMate atas nama '+applicant_name.strip()+'. '
+             'Pesan ini bukan klaim adanya lowongan dan bukan bukti bahwa lamaran diterima atau dibaca HR.\n\n'
+             'Pengiriman hanya boleh dilakukan setelah penerima dan seluruh isi pesan disetujui pengguna. '
+             'CV kandidat yang telah diperiksa akan dilampirkan pada saat pengujian disetujui.\n\nHormat saya,\n'+applicant_name.strip())
+    identity='\0'.join((recipient.strip().lower(),subject,content,cv_sha256))
+    return dict(to=recipient.strip().lower(),subject=subject,body=content,attachment_cv_sha256=cv_sha256,review_id=hashlib.sha256(identity.encode()).hexdigest(),
+                status='AWAITING_RECIPIENT_AND_CONTENT_APPROVAL',sending_enabled=False,email_count=1,note='Pratinjau tidak mengirim, mengantrekan, mengubah cron, atau mengaktifkan izin produksi.')
