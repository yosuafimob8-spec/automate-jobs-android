+"""National company directory. Additive storage, explicit provenance, no mail transport."""
+from __future__ import annotations
+import csv
+import hashlib
+import io
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import sqlite3
+from datetime import datetime, timezone
+from urllib.parse import urlsplit
+
+BASE=Path(__file__).resolve().parent
+PROVINCE_FILE=BASE/'data'/'indonesia_provinces.json'
+SEED_FILE=BASE/'data'/'national_company_contacts.json'
+DIRECTORY_DB=Path(os.environ.get('KARIRMATE_COMPANY_DB',str(BASE/'data'/'company_directory.sqlite3')))
+EMAIL=re.compile(r"[A-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[A-Z0-9.-]+\.[A-Z]{2,}",re.I)
+
+def provinces(): return json.loads(PROVINCE_FILE.read_text())['provinces']
+def normalized(value): return re.sub(r'[^\w]+',' ',str(value or '').casefold()).strip()
+def company_key(value):
+    words=normalized(value).split()
+    return ' '.join(w for w in words if w not in {'pt','cv','tbk','persero','perseroan','terbatas'})
+def position_key(value):
+    value=normalized(value)
+    aliases={'admin':'administrasi','staff administrasi':'administrasi','staf administrasi':'administrasi','administration':'administrasi','warehouse':'gudang','warehouse staff':'gudang','staf gudang':'gudang','staff gudang':'gudang','customer service':'layanan pelanggan'}
+    return aliases.get(value,value)
+def resolve_province(value):
+    value=normalized(value)
+    aliases={'dk jakarta':'31','jakarta':'31','dki jakarta':'31','yogyakarta':'34','di yogyakarta':'34','babel':'19'}
+    if value in aliases:return aliases[value]
+    return next((p['code'] for p in provinces() if value in (p['code'],normalized(p['name']))),None)
+def now_iso(): return datetime.now(timezone.utc).isoformat()
+
+def split_emails(value):
+    # Extract only addresses that actually occur in the input; never synthesize a pattern.
+    return sorted({m.group().strip('.').lower() for m in EMAIL.finditer(str(value or ''))})
+
+def _field(row,*names):
+    mapping={normalized(k):v for k,v in row.items()}
+    return next((str(mapping[normalized(k)]).strip() for k in names if mapping.get(normalized(k)) not in (None,'')), '')
+
+def normalize_record(raw,*,origin,owner_uid=None,reference='',checked_at=None):
+    name=_field(raw,'company','nama perusahaan','perusahaan','company name','namaperusahaan','nama')
+    email=_field(raw,'email','email hrd','email hr','email rekrutmen','recruitment email').lower()
+    if not name or not EMAIL.fullmatch(email):raise ValueError('Nama perusahaan dan email valid diperlukan.')
+    province=resolve_province(_field(raw,'province_code','provinsi','province'))
+    city=_field(raw,'city','kota','kabupaten','kota kabupaten')
+    location=_field(raw,'location','lokasi','alamat') or city
+    if province and not location:location=next(p['name'] for p in provinces() if p['code']==province)
+    # Names alone never establish where a company hires. Missing locality remains explicit.
+    source=_field(raw,'source_url','sumber','source','website','url')
+    declared_source=source
+    if source and (urlsplit(source).scheme!='https' or not urlsplit(source).hostname):
+        if origin!='owner_import':raise ValueError('Sumber web harus URL HTTPS.')
+        source=''
+    checked=checked_at or _field(raw,'checked_at','tanggal pemeriksaan') or now_iso()
+    record=dict(company=name,company_key=company_key(name),email=email,city=city,location=location,province_code=province,
+        industry=_field(raw,'industry','industri','sektor'),position=_field(raw,'position','posisi','jabatan'),
+        source_url=source,source_reference=reference or source,declared_source=declared_source,checked_at=checked,origin=origin,owner_uid=owner_uid,
+        vacancy_status='unknown',kind='spontaneous',vacancy_verified=False,active=False,
+        email_policy=_field(raw,'email_policy') or ('owner_provided' if origin=='owner_import' else 'needs_review'),
+        verification=_field(raw,'verification') or ('owner_file' if origin=='owner_import' else 'unverified'),
+        evidence_excerpt=_field(raw,'evidence_excerpt')[:160],source_sha256=_field(raw,'source_sha256'))
+    missing=[]
+    if not location and not province:missing.append('location')
+    if not province:missing.append('province')
+    if not record['industry']:missing.append('industry')
+    if not (source or reference):missing.append('source')
+    record['missing_fields']=missing
+    record['id']=hashlib.sha256(f"{owner_uid or 'public'}\0{record['company_key']}\0{email}\0{province or location}".encode()).hexdigest()[:32]
+    return record
+
+class DirectoryStore:
+    def __init__(self,path=None): self.path=Path(path or DIRECTORY_DB)
+    def initialize(self):
+        self.path.parent.mkdir(parents=True,exist_ok=True)
+        with sqlite3.connect(self.path) as db:
+            db.execute('''CREATE TABLE IF NOT EXISTS national_contacts(id TEXT PRIMARY KEY,company_key TEXT NOT NULL,email TEXT NOT NULL,owner_uid INTEGER,payload TEXT NOT NULL,updated_at TEXT NOT NULL)''')
+            db.execute('CREATE INDEX IF NOT EXISTS national_owner ON national_contacts(owner_uid,company_key,email)')
+            db.execute('''CREATE TABLE IF NOT EXISTS national_imports(id INTEGER PRIMARY KEY,source_sha256 TEXT NOT NULL,owner_uid INTEGER,imported_at TEXT NOT NULL,summary TEXT NOT NULL)''')
+    def records(self,uid=None):
+        if not self.path.exists():return []
+        with sqlite3.connect(f'file:{self.path}?mode=ro',uri=True) as db:
+            rows=db.execute('SELECT payload FROM national_contacts WHERE owner_uid IS NULL OR owner_uid=?',(uid,)).fetchall()
+        return [json.loads(r[0]) for r in rows]
+    def backup(self,destination):
+        if not self.path.exists():return None
+        target=Path(destination);target.parent.mkdir(parents=True,exist_ok=True)
+        with sqlite3.connect(f'file:{self.path}?mode=ro',uri=True) as src,sqlite3.connect(target) as dst:src.backup(dst)
+        return target
+    def merge(self,records,source_hash,owner_uid=None):
+        self.initialize();summary={'input_records':len(records),'inserted':0,'duplicates':0,'updated':0,'incomplete':0}
+        with sqlite3.connect(self.path,timeout=30) as db:
+            db.execute('BEGIN IMMEDIATE')
+            for item in records:
+                existing=db.execute('SELECT payload FROM national_contacts WHERE id=?',(item['id'],)).fetchone()
+                if existing:
+                    old=json.loads(existing[0]);merged=dict(old)
+                    # Blank import cells never erase established data or verification evidence.
+                    for k,v in item.items():
+                        if v not in (None,'',[],{}) and k not in ('verification','email_policy'):merged[k]=v
+                    if old.get('verification') in ('unverified','owner_file') and item.get('verification')=='official_page':
+                        merged['verification']='official_page';merged['email_policy']=item['email_policy']
+                    summary['duplicates']+=1
+                    if merged!=old:
+                        db.execute('UPDATE national_contacts SET payload=?,updated_at=? WHERE id=?',(json.dumps(merged,ensure_ascii=False),now_iso(),item['id']));summary['updated']+=1
+                else:
+                    db.execute('INSERT INTO national_contacts VALUES(?,?,?,?,?,?)',(item['id'],item['company_key'],item['email'],owner_uid,json.dumps(item,ensure_ascii=False),now_iso()));summary['inserted']+=1
+                if item['missing_fields']:summary['incomplete']+=1
+            db.execute('INSERT INTO national_imports(source_sha256,owner_uid,imported_at,summary) VALUES(?,?,?,?)',(source_hash,owner_uid,now_iso(),json.dumps(summary)))
+        return summary
+
+def import_contacts(path,store,owner_uid,*,backup_dir=None):
+    path=Path(path);raw=path.read_bytes()
+    if len(raw)>20*1024*1024:raise ValueError('File impor maksimal 20 MB.')
+    digest=hashlib.sha256(raw).hexdigest();rows=[]
+    if path.suffix.lower()=='.csv':
+        text=raw.decode('utf-8-sig');sample=text[:4096]
+        try:dialect=csv.Sniffer().sniff(sample,delimiters=',;\t')
+        except csv.Error:dialect=csv.excel
+        rows=[('CSV',n+2,row) for n,row in enumerate(csv.DictReader(io.StringIO(text),dialect=dialect))]
+    elif path.suffix.lower()=='.xlsx':
+        from openpyxl import load_workbook
+        # No macros or formulas are evaluated. A formula cell is never treated as an email.
+        import zipfile
+        with zipfile.ZipFile(io.BytesIO(raw)) as archive:
+            if len(archive.infolist())>5000 or sum(z.file_size for z in archive.infolist())>200_000_000:raise ValueError('Workbook melebihi batas ekstraksi aman.')
+        book=load_workbook(io.BytesIO(raw),read_only=True,data_only=False)
+        for sheet in book:
+            values=sheet.iter_rows(values_only=True);header=None;header_row=0
+            for n,maybe_header in enumerate(values,start=1):
+                keys=[normalized(v) for v in maybe_header]
+                if any('email' in k or 'e mail' in k for k in keys) and any(k in ('company','nama perusahaan','perusahaan','namaperusahaan','company name','nama') for k in keys):header=maybe_header;header_row=n;break
+                if n>=20:break
+            if header is None:continue
+            for n,values_row in enumerate(values,start=header_row+1):
+                rows.append((sheet.title,n,dict(zip(header,values_row))))
+                if len(rows)>100_000:raise ValueError('Impor maksimal 100.000 baris.')
+        book.close()
+    else:raise ValueError('Gunakan .xlsx atau CSV UTF-8.')
+    if len(rows)>100_000:raise ValueError('Impor maksimal 100.000 baris.')
+    if not rows:raise ValueError('Tidak ditemukan baris data dengan kolom perusahaan dan email. Periksa header workbook/CSV.')
+    records=[];invalid=[]
+    for sheet,n,row in rows:
+        if not any(v not in ('',None) for v in row.values()):continue
+        # Support columns Email 1 / Email 2 and multiple addresses in one cell.
+        email_values=' '.join(str(v or '') for k,v in row.items() if not str(v or '').lstrip().startswith('=') and ('email' in normalized(k) or 'e mail' in normalized(k) or normalized(k) in ('hrd','rekrutmen')))
+        addresses=split_emails(email_values)
+        if not addresses:invalid.append({'sheet':sheet,'row':n,'reason':'EMAIL_MISSING_OR_INVALID'});continue
+        for email in addresses:
+            try:records.append(normalize_record(dict(row,email=email),origin='owner_import',owner_uid=owner_uid,reference=f'owner-file:sha256:{digest}#{sheet}!{n}'))
+            except ValueError:invalid.append({'sheet':sheet,'row':n,'reason':'COMPANY_OR_SOURCE_INVALID'})
+    # Backup is created before any additive merge into an existing directory DB.
+    if store.path.exists():
+        if not backup_dir:raise ValueError('Tentukan direktori backup sebelum menggabungkan ke DB yang sudah ada.')
+        store.backup(Path(backup_dir)/f'company-directory-{datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%f")}.sqlite3')
+    summary=store.merge(records,digest,owner_uid)
+    return dict(summary,source_sha256=digest,invalid_rows=invalid,parsed_rows=len(rows),unique_input_emails=len({r['email'] for r in records}),unique_input_companies=len({r['company_key'] for r in records}))
+
+def seed_records():
+    if not SEED_FILE.exists():return []
+    return json.loads(SEED_FILE.read_text()).get('contacts',[])
+
+def combined_records(uid=None,legacy_db=None,store=None):
+    rows=(store or DirectoryStore()).records(uid)+seed_records()
+    if legacy_db is not None:
+        for table in ('km_stage1_sources','km_companies'):
+            columns={r[1] for r in legacy_db.execute(f'PRAGMA table_info({table})')}
+            if not {'company','email','user_id'}<=columns:continue
+            legacy_db.row_factory=sqlite3.Row
+            for row in legacy_db.execute(f'SELECT rowid AS source_row,* FROM {table} WHERE user_id=?',(uid,)):
+                raw=dict(row)
+                for email in split_emails(raw.get('email')):
+                    try:
+                        item=normalize_record(dict(raw,email=email),origin='owner_import',owner_uid=uid,reference=f'existing-db:{table}:{raw["source_row"]}')
+                        item['checked_at']=raw.get('checked_at') or raw.get('updated_at') or ''
+                        item['verification']='legacy_record'
+                        # Existing verified vacancies retain their evidence; never promote contacts to vacancies.
+                        if raw.get('vacancy_verified') in (1,True) and raw.get('active') in (1,True) and raw.get('evidence_url') and raw.get('expires_at'):
+                            item.update(kind='vacancy',vacancy_verified=True,active=True,evidence_url=raw['evidence_url'],expires_at=raw['expires_at'],vacancy_status='verified_active')
+                        rows.append(item)
+                    except ValueError:continue
+    result=[];seen=set()
+    # Owner records precede newly discovered public data; missing cells do not remove them.
+    for row in sorted(rows,key=lambda r:r.get('origin')!='owner_import'):
+        key=(row.get('company_key') or company_key(row['company']),row['email'].lower(),row.get('province_code') or row.get('location',''))
+        if key in seen:continue
+        seen.add(key);result.append(row)
+    return result
+
+def search(records,*,province='',city='',industry='',position='',offset=0,limit=50):
+    code=resolve_province(province) if province else None
+    if province and not code:raise ValueError('Provinsi tidak dikenali.')
+    selected=[r for r in records if (not code or r.get('province_code')==code) and
+              (not city or normalized(city) in normalized(r.get('city') or r.get('location'))) and
+              (not industry or normalized(industry) in normalized(r.get('industry'))) and
+              (not position or position_key(position) in position_key(r.get('position')))]
+    return {'items':selected[offset:offset+limit],'total':len(selected),'offset':offset,'next_offset':offset+limit if offset+limit<len(selected) else None}
+
+def statistics(records):
+    owner={r['email'].lower() for r in records if r.get('origin')=='owner_import'}
+    new={r['email'].lower() for r in records if r.get('origin')!='owner_import'}-owner
+    return {'companies':len({r.get('company_key') or company_key(r['company']) for r in records}),
+            'emails':len(owner|new),'owner_emails':len(owner),'new_emails':len(new),
