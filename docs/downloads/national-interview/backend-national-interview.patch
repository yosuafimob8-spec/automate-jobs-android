+"""Review public contacts periodically, dry-run by default. No cron or email operations.
+Changed/absent evidence requires manual review; it never enables a new recipient.
+"""
+import argparse
+from datetime import datetime,timezone
+import hashlib
+import json
+from pathlib import Path
+import sqlite3
+import sys
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'termux'/'automate-ai'))
+from national_directory import DirectoryStore,combined_records,now_iso
+from company_research.verify_public_pages import fetch
+
+
+def review(records,fetcher=fetch,force=False,now=None):
+    now=now or datetime.now(timezone.utc)
+    days=json.loads((Path(__file__).resolve().parents[1]/'termux'/'automate-ai'/'data'/'auto_apply_policy.json').read_text())['public_source_review_days']
+    cache={};changes=[]
+    for item in records:
+        if item.get('origin')!='public_search' or not item.get('source_url'):continue
+        try:
+            checked=datetime.fromisoformat(item.get('checked_at',''))
+            if checked.tzinfo is None:checked=checked.replace(tzinfo=timezone.utc)
+            due=(now-checked).total_seconds()>=days*86400
+        except ValueError:due=True
+        if not force and not due:continue
+        url=item['source_url']
+        if url not in cache:cache[url]=fetcher({'url':url,'title':item['company']})
+        page=cache[url];found=item['email'].lower() in {r['email'].lower() for r in page.get('found_emails',[])}
+        unchanged=page.get('fetch_status')==200 and found and page.get('source_sha256')==item.get('source_sha256')
+        updated=dict(item,last_review_attempt=now.isoformat(),last_review_status='unchanged_evidence' if unchanged else 'manual_review_required')
+        if unchanged:updated['checked_at']=page.get('checked_at') or now.isoformat()
+        else:updated['email_policy']='needs_review' # never infer permission from a new page/email alone
+        changes.append(updated)
+    return changes
+
+
+def apply_reviews(store,changes,backup_dir):
+    if not changes:return {'reviewed':0,'changed_or_unavailable':0,'backup':None}
+    backup=None
+    if store.path.exists():
+        backup=store.backup(Path(backup_dir)/f'company-review-{datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%f")}.sqlite3')
+    store.initialize()
+    with sqlite3.connect(store.path,timeout=30) as db:
+        db.execute('CREATE TABLE IF NOT EXISTS national_reviews(id INTEGER PRIMARY KEY,contact_id TEXT NOT NULL,reviewed_at TEXT NOT NULL,previous_payload TEXT NOT NULL,new_payload TEXT NOT NULL)')
+        db.execute('BEGIN IMMEDIATE')
+        for item in changes:
+            if item.get('origin')!='public_search' or item.get('owner_uid') is not None:raise ValueError('Owner records require owner review, not public refresh.')
+            existing=db.execute('SELECT payload,owner_uid FROM national_contacts WHERE id=?',(item['id'],)).fetchone()
+            if existing and existing[1] is not None:raise ValueError('Owner data cannot be replaced by public refresh.')
+            previous=existing[0] if existing else json.dumps(next((r for r in combined_records(store=store) if r['id']==item['id']),{}),ensure_ascii=False)
+            payload=json.dumps(item,ensure_ascii=False)
+            db.execute('INSERT INTO national_reviews(contact_id,reviewed_at,previous_payload,new_payload) VALUES(?,?,?,?)',(item['id'],now_iso(),previous,payload))
+            db.execute('INSERT INTO national_contacts VALUES(?,?,?,?,?,?) ON CONFLICT(id) DO UPDATE SET payload=excluded.payload,updated_at=excluded.updated_at',(item['id'],item['company_key'],item['email'],None,payload,now_iso()))
+    return {'reviewed':len(changes),'changed_or_unavailable':sum(x['last_review_status']=='manual_review_required' for x in changes),'backup':str(backup) if backup else None}
+
+
+def main():
+    p=argparse.ArgumentParser();p.add_argument('--db',type=Path,required=True);p.add_argument('--backup-dir',type=Path);p.add_argument('--apply',action='store_true');p.add_argument('--force',action='store_true');p.add_argument('--output',type=Path,required=True)
+    args=p.parse_args()
+    if args.apply and not args.backup_dir:p.error('--backup-dir is required with --apply')
+    store=DirectoryStore(args.db);changes=review(combined_records(store=store),force=args.force)
+    result={'mode':'apply' if args.apply else 'dry_run','checked_contacts':len(changes),'results':[{'id':r['id'],'source_url':r['source_url'],'status':r['last_review_status']} for r in changes]}
+    if args.apply:result['merge']=apply_reviews(store,changes,args.backup_dir)
+    args.output.write_text(json.dumps(result,ensure_ascii=False,indent=2)+'\n');print(json.dumps({k:v for k,v in result.items() if k!='results'}))
+if __name__=='__main__':main()
