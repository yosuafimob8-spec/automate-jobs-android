+"""Read-only directory API using the existing authenticated Android identity."""
+import sqlite3
+from urllib.parse import parse_qs,urlsplit
+from national_directory import combined_records,provinces,search,statistics
+from runtime_paths import DB
+
+ROUTES={'/companies','/companies/provinces','/companies/stats'}
+def handle(handler,path,method):
+    if path not in ROUTES:return False
+    try:
+        account=handler.authenticated_account()
+        if account is None:handler.respond(401,{'success':False,'code':'AUTH_REQUIRED','error':'Masuk kembali untuk mencari perusahaan.'});return True
+        if method!='GET':handler.respond(405,{'success':False,'error':'Direktori hanya menerima GET.'});return True
+        if path=='/companies/provinces':data={'provinces':provinces()}
+        else:
+            with sqlite3.connect(f'file:{DB}?mode=ro',uri=True) as db:
+                row=db.execute('SELECT telegram_user_id FROM android_accounts WHERE id=?',(account,)).fetchone()
+                uid=row[0] if row else None
+                rows=combined_records(uid,db) if uid is not None else combined_records()
+            if path=='/companies/stats':data=statistics(rows)
+            else:
+                q=parse_qs(urlsplit(handler.path).query)
+                allowed={'province','city','industry','position','offset'}
+                if set(q)-allowed or any(len(v)!=1 for v in q.values()):raise ValueError('Filter tidak valid.')
+                offset=int(q.get('offset',['0'])[0])
+                if not 0<=offset<=1_000_000:raise ValueError('Offset tidak valid.')
+                filters={k:q.get(k,[''])[0] for k in ('province','city','industry','position')}
+                if any(len(v)>150 for v in filters.values()):raise ValueError('Filter terlalu panjang.')
+                data=search(rows,offset=offset,**filters)
+                data['stats']=statistics(rows)
+            data['owner_data_status']='available_to_this_account' if uid is not None else 'account_not_linked'
+        handler.respond(200,dict(success=True,**data))
+    except (ValueError,TypeError) as error:handler.respond(400,{'success':False,'code':'INVALID_FILTER','error':str(error)})
+    except (OSError,sqlite3.Error):handler.respond(503,{'success':False,'code':'DIRECTORY_UNAVAILABLE','error':'Direktori belum dapat dibaca. Data lama tidak dihapus.'})
+    return True
