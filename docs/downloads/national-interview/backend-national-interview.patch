+"""Professional Indonesian messages with no invented vacancies or candidate skills."""
+def compose(name,company,position,kind):
+    if not all(isinstance(v,str) and v.strip() for v in (name,company,position)):raise ValueError('Nama kandidat, perusahaan dan posisi harus tersedia.')
+    if kind not in ('vacancy','spontaneous'):raise ValueError('Jenis lamaran belum terverifikasi.')
+    subject=f"Lamaran {'Spontan ' if kind=='spontaneous' else ''}{position.strip()} — {name.strip()}"
+    if kind=='spontaneous':
+        opening=f'Saya {name.strip()} bermaksud menyampaikan lamaran spontan untuk peluang pekerjaan yang relevan dengan posisi {position.strip()} di {company.strip()}. Saya tidak mengasumsikan bahwa perusahaan sedang membuka lowongan aktif.'
+    else:opening=f'Saya {name.strip()} bermaksud mengajukan lamaran untuk posisi {position.strip()} di {company.strip()}, berdasarkan informasi lowongan yang telah diperiksa.'
+    body=f'Yth. Tim Rekrutmen {company.strip()},\n\n{opening}\n\nSebagai bahan pertimbangan, saya melampirkan CV yang memuat pendidikan, pengalaman dan keterampilan saya. Saya bersedia memberikan informasi lebih lanjut apabila diperlukan.\n\nTerima kasih atas waktu dan pertimbangannya.\n\nHormat saya,\n{name.strip()}'
+    return {'subject':subject,'body':body,'application_kind':kind}
