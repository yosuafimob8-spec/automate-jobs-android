+"""Authenticated Android gateway for interview modules; no service is started on import."""
+import base64
+import json
+from pathlib import Path
+import re
+import sqlite3
+from urllib.parse import urlsplit
+from runtime_paths import DB
+from interview_core import InterviewSessionManager,InterviewError
+from interview_adapters import ServiceUnavailable
+
+_MANAGER=None
+SESSION=re.compile(r'^/interviews/sessions/([0-9a-f]{32})(?:/(answers|finish|webrtc|transcribe|speech))?$')
+
+def manager():
+    global _MANAGER
+    if _MANAGER is None:_MANAGER=InterviewSessionManager()
+    return _MANAGER
+
+def pro_status(handler):
+    account=handler.account_status() or {}
+    explicit=account.get('is_pro')
+    return explicit if isinstance(explicit,bool) else str(account.get('membership','')).lower()=='pro'
+
+def body(handler,limit=250000):
+    try:length=int(handler.headers.get('Content-Length','0'))
+    except ValueError:raise InterviewError('INVALID_BODY','Ukuran permintaan tidak valid.',400) from None
+    if not 0<length<=limit:raise InterviewError('INVALID_BODY','Permintaan terlalu besar atau kosong.',413)
+    raw=handler.rfile.read(length)
+    if len(raw)!=length:raise InterviewError('INVALID_BODY','Permintaan tidak lengkap.',400)
+    try:value=json.loads(raw)
+    except (ValueError,UnicodeError):raise InterviewError('INVALID_BODY','Gunakan objek JSON valid.',400) from None
+    if not isinstance(value,dict):raise InterviewError('INVALID_BODY','Objek JSON diperlukan.',400)
+    return value
+
+def backend_cv(account):
+    from phase512_sender import extract_cv_text
+    with sqlite3.connect(f'file:{DB}?mode=ro',uri=True) as db:
+        row=db.execute('SELECT c.cv_path FROM phase5_config c JOIN android_accounts a ON a.telegram_user_id=c.user_id WHERE a.id=?',(account,)).fetchone()
+    if not row or not row[0] or not Path(row[0]).is_file():raise InterviewError('CV_NOT_AVAILABLE','CV backend belum tersedia. Pilih CV aktif atau unggah PDF melalui Kirim Lamaran.')
+    try:return extract_cv_text(Path(row[0]))
+    except Exception:raise InterviewError('CV_EXTRACTION_FAILED','CV backend belum dapat dibaca; gunakan PDF teks tanpa kata sandi.') from None
+
+def handle(handler,path,method):
+    match=SESSION.fullmatch(path)
+    if not match and path not in ('/interviews/capabilities','/interviews/sessions','/interviews/history'):return False
+    try:
+        account=handler.authenticated_account()
+        if account is None:raise InterviewError('AUTH_REQUIRED','Sesi akun berakhir. Masuk kembali.',401)
+        pro=pro_status(handler);service=manager()
+        if path=='/interviews/capabilities' and method=='GET':data=service.capabilities(pro)
+        elif path=='/interviews/history' and method=='GET':data=service.history(account,pro)
+        elif path=='/interviews/sessions' and method=='POST':
+            value=body(handler)
+            if value.get('use_backend_cv') is True:value['cv']=backend_cv(account)
+            data={'session':service.start(account,value,pro)}
+        elif match:
+            id,action=match.groups()
+            if method=='GET' and action is None:data={'session':service.present(service.store.get(id,account),pro)}
+            elif method=='POST' and action=='answers':data={'session':service.answer(account,id,body(handler),pro)}
+            elif method=='POST' and action=='finish':data={'session':service.finish(account,id,pro)}
+            elif method=='POST' and action=='webrtc':data=service.offer(account,id,body(handler),pro)
+            elif method=='POST' and action in ('transcribe','speech'):
+                if not pro:raise InterviewError('PRO_REQUIRED','Layanan suara memerlukan PRO aktif.',403)
+                session=service.store.get(id,account)
+                if action=='transcribe':
+                    value=body(handler,14_000_000)
+                    try:audio=base64.b64decode(value.get('audio_base64',''),validate=True)
+                    except (ValueError,TypeError):raise InterviewError('INVALID_AUDIO','Audio base64 tidak valid.',400) from None
+                    data={'text':service.stt.transcribe(audio,session['settings']['language'],value.get('audio_format','wav'))}
+                else:
+                    if not session.get('question'):raise InterviewError('QUESTION_NOT_AVAILABLE','Sesi sudah selesai.')
+                    data={'audio_base64':base64.b64encode(service.tts.synthesize(session['question'],session['settings']['language'])).decode(),'content_type':'audio/wav'}
+            else:raise InterviewError('METHOD_NOT_ALLOWED','Metode interview tidak didukung.',405)
+        else:raise InterviewError('METHOD_NOT_ALLOWED','Metode interview tidak didukung.',405)
+        handler.respond(200,dict(success=True,**data))
+    except InterviewError as error:handler.respond(error.status,{'success':False,'code':error.code,'error':error.message})
+    except ServiceUnavailable as error:handler.respond(503,{'success':False,'code':'INTERVIEW_SERVICE_UNAVAILABLE','error':str(error)})
+    except ImportError as error:handler.respond(503,{'success':False,'code':'INTERVIEW_DEPENDENCY_MISSING','error':'Dependensi identitas/layanan belum tersedia.','missing_module':error.name})
+    except (sqlite3.Error,OSError):handler.respond(503,{'success':False,'code':'INTERVIEW_STORAGE_UNAVAILABLE','error':'Riwayat belum dapat dibaca/disimpan. Data lama tidak dihapus.'})
+    except Exception:handler.respond(503,{'success':False,'code':'INTERVIEW_BACKEND_ERROR','error':'Layanan interview belum dapat memproses permintaan. Jawaban tidak dinilai jika pemrosesan gagal.'})
+    return True
