+"""Explicit public-source audit. No email, login, user DB or scheduling."""
+import argparse
+from concurrent.futures import ThreadPoolExecutor
+from datetime import datetime,timezone
+import hashlib
+from html import unescape
+from html.parser import HTMLParser
+import json
+import ipaddress
+import socket
+from pathlib import Path
+import re
+import sys
+from urllib.parse import urlsplit
+import requests
+sys.path.insert(0,str(Path(__file__).resolve().parents[2]/'termux'/'automate-ai'))
+from national_directory import EMAIL
+
+class Text(HTMLParser):
+    def __init__(self):super().__init__();self.parts=[];self.skip=0
+    def handle_starttag(self,tag,attrs):
+        if tag in ('script','style','noscript'):self.skip+=1
+        if tag in ('p','div','br','li','h1','h2','h3','footer'):self.parts.append('\n')
+        if tag=='a':
+            href=dict(attrs).get('href','')
+            if href.startswith('mailto:'):self.parts.append(href[7:].split('?')[0])
+    def handle_endtag(self,tag):
+        if tag in ('script','style','noscript') and self.skip:self.skip-=1
+    def handle_data(self,data):
+        if not self.skip:self.parts.append(data)
+
+def public_source(url):
+    """Only public HTTPS sources; no redirects, credentials or private destinations."""
+    parsed=urlsplit(url);host=parsed.hostname or ''
+    if parsed.scheme!='https' or parsed.username or parsed.password or parsed.port not in (None,443) or parsed.fragment:
+        return False
+    if not host or host=='localhost' or host.endswith(('.local','.internal','.localhost')):return False
+    try:
+        addresses=socket.getaddrinfo(host,443,type=socket.SOCK_STREAM)
+        return bool(addresses) and all(ipaddress.ip_address(row[4][0]).is_global for row in addresses)
+    except (OSError,ValueError):return False
+
+def fetch(candidate):
+    url=candidate['url'];host=urlsplit(url).hostname or ''
+    if not public_source(url):
+        return dict(candidate,fetch_status='invalid_source')
+    try:
+        with requests.get(url,timeout=(8,18),stream=True,allow_redirects=False,headers={'User-Agent':'KarirMate-Source-Audit/1.0'}) as response:
+            if response.status_code!=200:return dict(candidate,fetch_status=response.status_code)
+            if 'text/' not in response.headers.get('Content-Type','').lower():return dict(candidate,fetch_status='non_text_source')
+            content=bytearray()
+            for chunk in response.iter_content(65536):
+                content.extend(chunk)
+                if len(content)>3_000_000:raise ValueError('source exceeds 3 MB')
+            parser=Text();parser.feed(bytes(content).decode(response.encoding or 'utf-8',errors='replace'))
+            text=unescape('\n'.join(parser.parts));text=re.sub(r'[ \t]+',' ',text)
+            for encoded in re.findall(r'data-cfemail=[\"\x27]([0-9a-f]+)',bytes(content).decode('utf-8',errors='ignore'),re.I):
+                raw=bytes.fromhex(encoded);text+='\n'+''.join(chr(x^raw[0]) for x in raw[1:])
+            title=re.search(r'<title[^>]*>(.*?)</title',bytes(content).decode('utf-8',errors='ignore'),re.I|re.S)
+            emails=[]
+            for match in EMAIL.finditer(text):
+                email=match.group().strip('.').lower();context=' '.join(text[max(0,match.start()-160):match.end()+120].split())
+                emails.append({'email':email,'context':context[:160]})
+            return dict(candidate,fetch_status=200,page_title=unescape(title[1]) if title else candidate.get('title',''),checked_at=datetime.now(timezone.utc).isoformat(),source_sha256=hashlib.sha256(content).hexdigest(),found_emails=list({x['email']:x for x in emails}.values()),page_text=text[:160000])
+    except Exception as error:return dict(candidate,fetch_status=type(error).__name__)
+
+def main():
+    p=argparse.ArgumentParser();p.add_argument('candidates',type=Path);p.add_argument('--output',type=Path,required=True);args=p.parse_args()
+    rows=json.loads(args.candidates.read_text())
+    excluded=('linkedin.com','infokerjakaltim.co.id','jogjalowker.co.id','hhrma.co.id','lowkersemarang.co.id','smartbid.co.id','rri.co.id','karirgram.com','beritajogja.co.id','safetyfirstindonesia.co.id','bnsp.go.id')
+    rows=[r for r in rows if not any((urlsplit(r['url']).hostname or '').endswith(d) for d in excluded) and not r['url'].lower().endswith('.pdf')]
+    with ThreadPoolExecutor(max_workers=4) as pool:
+        result=[]
+        for item in pool.map(fetch,rows):
+            result.append(item);args.output.write_text(json.dumps(result,ensure_ascii=False,indent=2)+'\n')
+            print(json.dumps({'host':urlsplit(item['url']).hostname,'status':item['fetch_status'],'email_count':len(item.get('found_emails',[]))}),flush=True)
+if __name__=='__main__':main()
