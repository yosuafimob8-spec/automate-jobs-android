diff --git a/gpu_worker/musetalk_gateway.py b/gpu_worker/musetalk_gateway.py
new file mode 100644
index 0000000..46a1bad
--- /dev/null
+++ b/gpu_worker/musetalk_gateway.py
@@ -0,0 +1,87 @@
+"""Separate GPU-only gateway for the audited LiveTalking MuseTalk integration.
+No side effects on import. Never launch this in Termux or on KarirMate's existing ports.
+"""
+import argparse
+from http.server import BaseHTTPRequestHandler,ThreadingHTTPServer
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import secrets
+import re
+import sys
+from urllib.parse import urlsplit
+import requests
+
+class MuseTalkIntegration:
+    def __init__(self,root,manifest,upstream='http://127.0.0.1:8791',transport=requests):
+        self.root=Path(root);self.manifest=Path(manifest);self.upstream=upstream.rstrip('/');self.transport=transport
+        parsed=urlsplit(self.upstream)
+        if parsed.hostname not in ('127.0.0.1','localhost') or parsed.port in (8787,8788,8789):raise ValueError('LiveTalking upstream must use a separate loopback worker port.')
+    def avatar(self):
+        try:
+            data=json.loads(self.manifest.read_text())
+            if data.get('approved') is not True or data.get('usage')!='commercial_interview' or data.get('identity_basis') not in ('original_synthetic','consenting_actor'):return None
+            if not data.get('release_reference') or not re.fullmatch(r'[A-Za-z0-9_-]{1,100}',str(data.get('avatar_id') or '')) or not data.get('rights_holder'):return None
+            source=Path(data['source_video'])
+            if not source.is_file() or hashlib.sha256(source.read_bytes()).hexdigest()!=data.get('source_sha256'):return None
+            return data
+        except (OSError,ValueError,KeyError):return None
+    def health(self):
+        gpu=False
+        if not Path('/data/data/com.termux').exists() and importlib.util.find_spec('torch'):
+            import torch
+            gpu=torch.cuda.is_available()
+        avatar=self.avatar()
+        weights=(self.root/'models'/'musetalkV15'/'unet.pth').is_file() or (self.root/'models'/'musetalk'/'pytorch_model.bin').is_file()
+        prepared=bool(avatar and (self.root/'data'/'avatars'/avatar['avatar_id']/'coords.pkl').is_file() and (self.root/'data'/'avatars'/avatar['avatar_id']/'mask_coords.pkl').is_file())
+        renderer=(self.root/'avatars'/'musetalk_avatar.py').is_file() or (self.root/'musetalkreal.py').is_file()
+        upstream=False
+        if gpu and weights and renderer and avatar and prepared:
+            try:
+                response=self.transport.get(self.upstream+'/index.html',timeout=(2,5),allow_redirects=False);upstream=response.status_code==200
+            except requests.RequestException:pass
+        return dict(model='musetalk',gpu_available=gpu,weights_available=weights,avatar_prepared=prepared,renderer_available=renderer,avatar_license_verified=avatar is not None,upstream_ready=upstream,avatar_id=avatar['avatar_id'] if avatar else None,reason='READY' if upstream else 'GPU_MODEL_AVATAR_OR_UPSTREAM_UNAVAILABLE')
+    def forward(self,path,body):
+        health=self.health()
+        if not health['upstream_ready']:raise ValueError('MuseTalk worker is not ready; use text/voice fallback.')
+        if path=='/offer':
+            if body.get('avatar')!=health['avatar_id'] or body.get('type')!='offer':raise ValueError('Only the approved avatar and WebRTC offer are accepted.')
+            allowed={k:body[k] for k in ('sdp','type','avatar')}
+        elif path=='/human':allowed={k:body[k] for k in ('sessionid','type','text','interrupt') if k in body}
+        else:raise ValueError('Worker route not allowed.')
+        if path=='/human' and (allowed.get('type')!='echo' or len(str(allowed.get('text','')))>2000):raise ValueError('Only interview text echo is accepted, never upstream chat/provider settings.')
+        response=self.transport.post(self.upstream+path,json=allowed,timeout=(5,45),allow_redirects=False);response.raise_for_status();return response.json()
+
+class WebRtcSessionHandler(BaseHTTPRequestHandler):
+    integration=None;key=''
+    def respond(self,status,data):
+        raw=json.dumps(data).encode();self.send_response(status);self.send_header('Content-Type','application/json');self.send_header('Cache-Control','no-store');self.send_header('Content-Length',str(len(raw)));self.end_headers();self.wfile.write(raw)
+    def authorized(self):return bool(self.key and secrets.compare_digest(self.headers.get('Authorization',''),'Bearer '+self.key))
+    def do_GET(self):
+        if not self.authorized():return self.respond(401,{'error':'Worker authorization required'})
+        if self.path!='/health':return self.respond(404,{'error':'Unknown worker route'})
+        self.respond(200,self.integration.health())
+    def do_POST(self):
+        if not self.authorized():return self.respond(401,{'error':'Worker authorization required'})
+        if self.path not in ('/offer','/human'):return self.respond(404,{'error':'Unknown worker route'})
+        try:
+            size=int(self.headers.get('Content-Length','0'))
+            if not 0<size<=150000:raise ValueError('Worker request limit exceeded')
+            body=json.loads(self.rfile.read(size))
+            if not isinstance(body,dict):raise ValueError('Object required')
+            self.respond(200,self.integration.forward(self.path,body))
+        except (ValueError,KeyError):self.respond(409,{'error':'Worker not ready or invalid approved-avatar request'})
+        except requests.RequestException:self.respond(503,{'error':'LiveTalking upstream unavailable'})
+    def log_message(self,*args):pass # Never log SDP, CV/answer content or bearer keys.
+
+def main():
+    p=argparse.ArgumentParser();p.add_argument('--root',type=Path,required=True);p.add_argument('--avatar-manifest',type=Path,required=True);p.add_argument('--port',type=int,default=8792);args=p.parse_args()
+    if args.port in (8787,8788,8789) or not 1024<=args.port<=65535:p.error('Use an isolated worker port, never 8787–8789.')
+    if Path('/data/data/com.termux').exists() or 'com.termux' in str(Path(sys.executable)):p.error('MuseTalk must run on a separate GPU host, not Termux.')
+    key=os.environ.get('KARIRMATE_GPU_GATEWAY_KEY','')
+    if len(key)<24:p.error('Configure the worker-only key outside Git; minimum 24 characters.')
+    WebRtcSessionHandler.integration=MuseTalkIntegration(args.root,args.avatar_manifest);WebRtcSessionHandler.key=key
+    ThreadingHTTPServer(('127.0.0.1',args.port),WebRtcSessionHandler).serve_forever()
+if __name__=='__main__':main()
