+"""Persistent bilingual interview engine. Rules work on CPU; optional Ollama is real HTTP."""
+from __future__ import annotations
+from datetime import datetime,timezone
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import sqlite3
+import threading
+import uuid
+from interview_adapters import OllamaAdapter,LiveTalkingAdapter,SpeechToTextAdapter,TextToSpeechAdapter,ServiceUnavailable
+
+class InterviewError(Exception):
+    def __init__(self,code,message,status=409):self.code,self.message,self.status=code,message,status
+
+class CvContextAdapter:
+    @staticmethod
+    def from_content(value):
+        if isinstance(value,str):text=value
+        elif isinstance(value,dict):
+            # Contacts are unnecessary for questions/scoring and are not sent to an LLM.
+            selected={k:value[k] for k in ('summary','experience','education','skills','projects','certifications') if k in value}
+            headline=value.get('contact',{}).get('headline','') if isinstance(value.get('contact'),dict) else ''
+            def plain(item):
+                if isinstance(item,dict):return ' '.join(plain(v) for k,v in item.items() if k not in ('id','photoPath','link','website','gpa'))
+                if isinstance(item,list):return ' '.join(plain(v) for v in item)
+                return str(item or '')
+            text=headline+'\n'+plain(selected)
+        else:text=''
+        text=re.sub(r'[\w.+-]+@[\w.-]+\.[A-Za-z]{2,}','[kontak disembunyikan]',text)
+        text=re.sub(r'(?:\+62|08)[\d ()-]{7,18}\d','[kontak disembunyikan]',text)
+        if sum(c.isalpha() for c in text)<40:raise InterviewError('CV_CONTEXT_REQUIRED','Isi CV aktif atau unggah CV PDF yang dapat dibaca sebelum memulai interview.')
+        return text[:20000]
+
+class InterviewQuestionEngine:
+    def __init__(self,llm=None):self.llm=llm or OllamaAdapter()
+    def next(self,context,settings,answers):
+        if self.llm.configured:
+            try:return self.llm.question(context,dict(settings,question_index=len(answers)),answers if settings['adaptive'] else []),'ollama',None
+            except ServiceUnavailable as error:notice=str(error)
+        else:notice='Model AI self-hosted belum terhubung; sesi memakai pertanyaan dan evaluasi terstruktur.' if not self.llm.configured else None
+        en=settings['language']=='en';role=settings['position'];n=len(answers)
+        if n==0:
+            question=f'Tell me about your background and the experience in your CV most relevant to {role}.' if en else f'Ceritakan latar belakang Anda dan pengalaman dalam CV yang paling relevan dengan posisi {role}.'
+        elif settings['adaptive'] and len(answers[-1]['answer'].split())<25:
+            question='Could you expand your last answer with your own actions and the actual result? Use a real example; do not invent experience.' if en else 'Bisa jelaskan jawaban sebelumnya dengan tindakan pribadi dan hasil yang benar-benar terjadi? Gunakan contoh nyata, tanpa mengarang pengalaman.'
+        else:
+            questions_en=[f'Describe a real challenge related to {role}. What was your task, action and result?',f'Which skills from your CV would you use as {role}, and how have you applied them?',f'How would you handle competing deadlines as {role}? Explain your priorities.',f'What would your first learning priorities be in {role}? Describe an honest development plan.']
+            questions_id=[f'Ceritakan tantangan nyata yang relevan dengan {role}. Apa tugas, tindakan dan hasil Anda?',f'Keterampilan apa dari CV yang akan Anda gunakan sebagai {role}, dan bagaimana penerapannya?',f'Bagaimana Anda menangani tenggat yang berbenturan sebagai {role}? Jelaskan prioritas Anda.',f'Apa prioritas belajar awal Anda sebagai {role}? Jelaskan rencana pengembangan yang realistis.']
+            question=(questions_en if en else questions_id)[min(n-1,3)]
+        if settings['difficulty']=='professional':question+=(' Explain the trade-offs and evidence behind your decision.' if en else ' Jelaskan pertimbangan dan bukti di balik keputusan Anda.')
+        elif settings['difficulty']=='intermediate':question+=(' Include a concrete example.' if en else ' Sertakan contoh konkret.')
+        lens={'hr':('Focus on teamwork and motivation.','Fokus pada kerja sama dan motivasi.'),'user':('Focus on work methods and relevant skills.','Fokus pada cara kerja dan keterampilan relevan.'),'manager':('Focus on priorities, outcomes and responsibility.','Fokus pada prioritas, hasil dan tanggung jawab.')}
+        question+=' '+lens[settings['interviewer']][0 if en else 1]
+        # Add a short factual CV cue without exposing contact details or inventing credentials.
+        if n==2:
+            cue=context.replace('\n',' ')[:100]
+            question+=(' CV context: ' if en else ' Konteks CV: ')+cue
+        return question,'structured_rules',notice
+
+class InterviewScoringEngine:
+    @staticmethod
+    def score(context,settings,answers,pro):
+        if not answers:raise InterviewError('ANSWER_REQUIRED','Jawab setidaknya satu pertanyaan sebelum melihat penilaian.')
+        role_tokens=set(re.findall(r'[a-z]{3,}',settings['position'].casefold()))
+        cv_tokens=set(re.findall(r'[a-z]{4,}',context.casefold()))
+        items=[]
+        for turn in answers:
+            text=turn['answer'];words=text.split();tokens=set(re.findall(r'[a-z]{3,}',text.casefold()))
+            structure=sum(bool(re.search(pattern,text,re.I)) for pattern in (r'tugas|task|responsib',r'tindakan|action|saya|\bi\b',r'hasil|result|meningkat|improv|selesai|completed'))
+            quality=min(100,20+min(len(words),80)//2+structure*12)
+            relevance=min(100,20+len(tokens&role_tokens)*20+min(30,len(tokens&cv_tokens)*5))
+            communication=min(100,20+min(len(words),50)+min(20,len(re.findall(r'[.!?]',text))*5))
+            items.append(dict(quality=quality,relevance=relevance,communication=communication))
+        avg=lambda key:round(sum(x[key] for x in items)/len(items))
+        quality,relevance,communication=avg('quality'),avg('relevance'),avg('communication')
+        strengths=[];weaknesses=[]
+        for score,label in ((quality,'Struktur dan bukti jawaban'),(relevance,'Relevansi terhadap posisi/CV'),(communication,'Kejelasan teks jawaban')):
+            (strengths if score>=65 else weaknesses).append(label)
+        result=dict(overall=round((quality+relevance+communication)/3),quality=quality,relevance=relevance,communication=communication,
+                    strengths=strengths,weaknesses=weaknesses,evaluation_method='structured_text_rules',
+                    note='Penilaian latihan berdasarkan teks dan aturan transparan; bukan keputusan perekrut, asesmen kepribadian, penampilan atau kemampuan suara.',
+                    recommendations=['Gunakan contoh yang benar-benar dialami dan uraikan tugas, tindakan pribadi serta hasil.','Hubungkan jawaban dengan tanggung jawab posisi dan keterampilan yang tercantum dalam CV.'])
+        if settings['language']=='en':
+            text=' '.join(x['answer'] for x in answers)
+            flags=[pattern for pattern in ('I has','I is','he have','she have','they is') if re.search(r'\b'+pattern+r'\b',text,re.I)]
+            result['english_feedback']={'basis':'basic transcript/text checks, not pronunciation','patterns_to_review':flags,'recommendation':'Check subject–verb agreement, complete sentences and clear examples. This is not a comprehensive language proficiency test.'}
+        if pro:
+            result['deep_analysis']=items
+            actual=answers[-1]['answer'].strip()
+            result['improved_answer']=('Suggested organisation using your own answer: ' if settings['language']=='en' else 'Contoh penyusunan ulang dari jawaban Anda: ')+actual+(' Explain your own action and the real outcome; if these are missing, add only facts you can substantiate.' if settings['language']=='en' else ' Perjelas tindakan pribadi serta hasil nyata. Tambahkan hanya fakta yang dapat Anda pertanggungjawabkan.')
+            result['practice_plan']=['Pilih satu jawaban dengan relevansi rendah dan hubungkan kembali ke tugas posisi.','Latih jawaban ringkas dengan bukti tindakan dan hasil, lalu bandingkan sesi berikutnya.']
+        return result
+
+class InterviewStore:
+    def __init__(self,path=None):self.path=Path(path or os.environ.get('KARIRMATE_INTERVIEW_DB',str(Path(__file__).resolve().parent/'data'/'interviews.sqlite3')))
+    def initialize(self):
+        self.path.parent.mkdir(parents=True,exist_ok=True)
+        with sqlite3.connect(self.path) as db:
+            db.execute('''CREATE TABLE IF NOT EXISTS interviews(id TEXT PRIMARY KEY,account_id INTEGER NOT NULL,revision INTEGER NOT NULL,status TEXT NOT NULL,payload TEXT NOT NULL,created_at TEXT NOT NULL)''')
+            db.execute('CREATE INDEX IF NOT EXISTS interview_owner ON interviews(account_id,created_at)')
+            db.execute('''CREATE TABLE IF NOT EXISTS interview_requests(session_id TEXT NOT NULL,request_id TEXT NOT NULL,request_hash TEXT NOT NULL,response TEXT NOT NULL,PRIMARY KEY(session_id,request_id))''')
+    def get(self,id,account):
+        if not self.path.exists():raise InterviewError('SESSION_NOT_FOUND','Sesi interview tidak ditemukan.',404)
+        with sqlite3.connect(f'file:{self.path}?mode=ro',uri=True) as db:
+            row=db.execute('SELECT payload FROM interviews WHERE id=? AND account_id=?',(id,account)).fetchone()
+        if not row:raise InterviewError('SESSION_NOT_FOUND','Sesi interview tidak ditemukan pada akun ini.',404)
+        return json.loads(row[0])
+
+class InterviewSessionManager:
+    def __init__(self,store=None,engine=None,avatar=None,stt=None,tts=None):
+        self.store=store or InterviewStore();self.engine=engine or InterviewQuestionEngine();self.avatar=avatar or LiveTalkingAdapter();self.stt=stt or SpeechToTextAdapter();self.tts=tts or TextToSpeechAdapter()
+        self._locks={};self._lock=threading.Lock()
+    def lock(self,id):
+        with self._lock:return self._locks.setdefault(id,threading.Lock())
+    def capabilities(self,pro):
+        video=self.avatar.health() if pro else {'available':False,'reason':'PRO_REQUIRED'}
+        stt_ready=bool(pro and self.stt.ready());tts_ready=bool(pro and self.tts.ready())
+        return dict(text=True,question_engine='ollama' if self.engine.llm.configured else 'structured_rules',paid_api=False,voice_backend=stt_ready and tts_ready,voice_on_device_allowed=pro,stt_available=stt_ready,tts_available=tts_ready,
+                    video=video,deep_analysis=pro,languages=['id','en'],fallback_notice='Teks tetap tersedia tanpa GPU. Suara memerlukan layanan/perangkat yang tersedia. Video tidak tersedia sampai worker dan avatar berizin siap.')
+    def start(self,account,body,pro):
+        settings={k:body.get(k) for k in ('language','position','difficulty','interviewer','mode')}
+        enums={'language':('id','en'),'difficulty':('beginner','intermediate','professional'),'interviewer':('hr','user','manager'),'mode':('text','voice','video')}
+        if any(settings[k] not in values for k,values in enums.items()):raise InterviewError('INVALID_SETTINGS','Periksa bahasa, tingkat, pewawancara dan mode.',400)
+        if not isinstance(settings['position'],str) or not 2<=len(settings['position'].strip())<=120:raise InterviewError('POSITION_REQUIRED','Isi posisi tujuan (2–120 karakter).',400)
+        settings['position']=settings['position'].strip();settings['adaptive']=pro
+        if settings['mode']!='text' and not pro:raise InterviewError('PRO_REQUIRED','Interview suara/video memerlukan PRO aktif.',403)
